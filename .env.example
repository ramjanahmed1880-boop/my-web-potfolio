# Copy this file to ".env" for local development.
# On Render, add the same names under Environment -> Environment Variables.
#
# IMPORTANT: every VITE_* value is bundled into the public website.
# Only put PUBLIC contact details here. NEVER put API keys, tokens or passwords.
#
# Every value is optional. A contact button only appears when its value is set.

# Public address of the deployed site, e.g. https://your-site.onrender.com
# (used for canonical URL, sitemap.xml and robots.txt)
VITE_SITE_URL=

# Contact channels
VITE_CONTACT_EMAIL=
# Digits only with country code, e.g. 15551234567 (no +, spaces or dashes)
VITE_WHATSAPP_NUMBER=
# Telegram username without the @
VITE_TELEGRAM_USERNAME=

# Profile links (full https:// URLs)
VITE_GITHUB_URL=
VITE_FACEBOOK_URL=
VITE_YOUTUBE_URL=
VITE_LINKEDIN_URL=

# Optional short bio shown on the About page (plain text)
VITE_ABOUT_BIO=
